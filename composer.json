{
    "name": "wwwision/subscription-engine-neos-adapter",
    "description": "neos/eventstore adapter for wwwision/subscription-engine",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bastian Waidelich",
            "email": "b.waidelich@wwwision.de"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/bwaidelich"
        },
        {
            "type": "paypal",
            "url": "https://www.paypal.me/bwaidelich"
        }
    ],
    "require": {
        "php": ">=8.3",
        "neos/eventstore": "^1.0.3 || ^2.0.2",
        "wwwision/subscription-engine": "^2"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^4",
        "phpunit/phpunit": "^11",
        "doctrine/dbal": "^3.6",
        "neos/eventstore-doctrineadapter": "^2.0.1 || ^3",
        "psr/clock": "^1"
    },
    "conflict": {
        "neos/eventstore-doctrineadapter": "<2.0.1"
    },
    "autoload": {
        "psr-4": {
            "Wwwision\\SubscriptionEngineNeosAdapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wwwision\\SubscriptionEngineNeosAdapter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:phpstan": "phpstan",
        "test:cs": "phpcs --colors src",
        "test:cs:fix": "phpcbf --colors src",
        "test:phpunit": "phpunit",
        "test": [
            "@test:phpstan",
            "@test:cs",
            "@test:phpunit"
        ]
    }
}
